#include <stdlib.h>

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced.
 */
void backtrack(int n, int k, int start, int* current, int currentSize, 
               int** result, int* returnSize) {
    // Base case: if current combination is of size k
    if (currentSize == k) {
        result[*returnSize] = (int*)malloc(k * sizeof(int));
        for (int i = 0; i < k; i++) {
            result[*returnSize][i] = current[i];
        }
        (*returnSize)++;
        return;
    }

    // Standard backtracking loop
    for (int i = start; i <= n; i++) {
        current[currentSize] = i;
        backtrack(n, k, i + 1, current, currentSize + 1, result, returnSize);
    }
}

// Function to calculate nCr for result size allocation
int combinations_count(int n, int k) {
    if (k > n / 2) k = n - k;
    long long res = 1;
    for (int i = 1; i <= k; i++) {
        res = res * (n - i + 1) / i;
    }
    return (int)res;
}

int** combine(int n, int k, int* returnSize, int** returnColumnSizes) {
    int total = combinations_count(n, k);
    int** result = (int**)malloc(total * sizeof(int*));
    *returnColumnSizes = (int*)malloc(total * sizeof(int));
    *returnSize = 0;

    int* current = (int*)malloc(k * sizeof(int));
    backtrack(n, k, 1, current, 0, result, returnSize);
    
    // Set column sizes for all returned combinations
    for (int i = 0; i < total; i++) {
        (*returnColumnSizes)[i] = k;
    }

    free(current);
    return result;
}
