#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

struct ListNode* partition(struct ListNode* head, int x) {
    // Dummy nodes to simplify boundary cases
    struct ListNode lessHead, greaterHead;
    struct ListNode *lessPtr = &lessHead;
    struct ListNode *greaterPtr = &greaterHead;

    // Initialize next pointers to NULL
    lessHead.next = NULL;
    greaterHead.next = NULL;

    struct ListNode* curr = head;
    while (curr != NULL) {
        if (curr->val < x) {
            // Append to the 'less' partition
            lessPtr->next = curr;
            lessPtr = lessPtr->next;
        } else {
            // Append to the 'greater or equal' partition
            greaterPtr->next = curr;
            greaterPtr = greaterPtr->next;
        }
        curr = curr->next;
    }

    // Terminate the greater partition to avoid cycles
    greaterPtr->next = NULL;
    
    // Connect the two partitions
    lessPtr->next = greaterHead.next;

    return lessHead.next;
}
