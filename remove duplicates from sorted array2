int removeDuplicates(int* nums, int numsSize) {
    // If the array has 2 or fewer elements, they are all allowed
    if (numsSize <= 2) return numsSize;

    // 'k' is the write pointer, representing the index where 
    // the next valid element should be placed.
    int k = 2; 

    for (int i = 2; i < numsSize; i++) {
        // If the current element is different from the element 
        // two positions back in our "new" array
        if (nums[i] != nums[k - 2]) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
